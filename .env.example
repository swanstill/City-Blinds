# Twilio credentials (from https://console.twilio.com)
# Account SID: Console -> Account Info
# Auth Token:  Console -> API Keys & Tokens -> Main Auth Token
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_real_auth_token

# Twilio-owned number that sends the SMS (E.164, e.g. +441234567890)
TWILIO_FROM_NUMBER=+44xxxxxxxxxx

# Mobile number that receives the lead SMS (E.164, e.g. +447700900123).
# MUST be a mobile that can receive SMS — NOT the published landline 01733 590919.
BUSINESS_PHONE=+44xxxxxxxxxx
